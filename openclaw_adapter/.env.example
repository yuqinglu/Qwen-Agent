# 联调计划: ../ty_mem_agent/doc/OPENCLAW_INTEGRATION_RUNBOOK.md
# 阶段0自检: python scripts/check_phase0.py

# 监听
ADAPTER_HOST=0.0.0.0
ADAPTER_PORT=8090

# ty-mem-agent 调用适配层时使用的 Bearer（与 ty_mem_agent OPENCLAW_API_KEY 一致）
ADAPTER_API_KEY=change-me-adapter-key

# 适配层回调 ty-mem-agent 时 HMAC 密钥（与 ty_mem_agent OPENCLAW_CALLBACK_SECRET 一致）
TY_MEM_CALLBACK_HMAC_SECRET=change-me-hmac-secret

# 本适配层对公网/内网可访问的根 URL（无路径后缀；webhook 实际为 {此值}/openclaw-adapter/internal/openclaw/webhook）
ADAPTER_PUBLIC_BASE_URL=http://127.0.0.1:8090
# ty-mem 侧 OPENCLAW_API_BASE 须为 {此值}/openclaw-adapter/v1（勿漏 /openclaw-adapter）

# OpenClaw Gateway 回调适配层时带的 Bearer（与 Gateway cron.webhookToken 一致，可选）
OPENCLAW_WEBHOOK_BEARER_TOKEN=

# Gateway：stub=仅本地不落 OpenClaw；http=开源默认 POST OpenClaw 的 /tools/invoke
ADAPTER_GATEWAY_MODE=stub
# 与 Gateway 同端口（默认 18789），见 https://docs.openclaw.ai/gateway/tools-invoke-http-api
ADAPTER_GATEWAY_HTTP_URL=http://127.0.0.1:18789/tools/invoke
# 与 gateway.auth.token / OPENCLAW_GATEWAY_TOKEN 一致
ADAPTER_GATEWAY_HTTP_TOKEN=
# 若使用其它 HTTP 取消语义可填；留空则对同一 ADAPTER_GATEWAY_HTTP_URL POST cron.remove（开源默认）
ADAPTER_GATEWAY_HTTP_REMOVE_URL=
# {body} 为 cron.add 的参数字典（与官方 Cron 文档一致）；invoke 形态为 tool=cron + action=add
ADAPTER_GATEWAY_HTTP_BODY_TEMPLATE={"tool":"cron","action":"add","args":{body}}
# /tools/invoke 成功时一般为 { "ok": true, "result": { "jobId": "..." } }
ADAPTER_GATEWAY_HTTP_JOB_ID_PATH=result.jobId

# SQLite
ADAPTER_DATABASE_URL=sqlite+aiosqlite:///./data/adapter.db

# 仅开发：POST /internal/dev/simulate-callback
ADAPTER_DEV_ENDPOINTS=false

# --- Nacos 服务注册（与 ty_mem_agent 相同变量名；关闭则不注册）---
NACOS_ENABLED=false
NACOS_SERVER_ADDRESSES=localhost:8848
# NACOS_NAMESPACE=
# NACOS_USERNAME=
# NACOS_PASSWORD=
NACOS_SERVICE_NAME=openclaw-adapter
# NACOS_GROUP_NAME=
# 可选：JSON 对象，合并进 Nacos 实例 metadata
# NACOS_METADATA_EXTRA_JSON={"env":"dev"}
