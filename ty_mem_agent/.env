# TY Memory Agent Docker 环境变量配置示例
# 使用方法：复制此文件为 .env 并填写实际值
# cp env.docker.example .env

# ========================================
# 基础配置
# ========================================
# 服务监听地址（0.0.0.0 表示接受所有网络接口的请求，包括外部请求）
HOST=0.0.0.0
# 服务端口（外部访问地址: http://<服务器IP>:10081）
PORT=10081
# 调试模式（生产环境建议设置为 false）
DEBUG=false

# ========================================
# CORS 跨域配置
# ========================================
# 允许的来源域名（用于APP或Web端调用）
# - 使用 * 表示允许所有来源（适合APP调用，开发环境推荐）
# - 生产环境建议设置为具体域名，多个域名用逗号分隔
# 示例: ALLOWED_ORIGINS=https://your-app.com,https://api.your-app.com
ALLOWED_ORIGINS=*


# === LLM配置 ===
# DashScope配置（推荐）
DASHSCOPE_API_KEY=sk-b7c5e3b5866f4922b9de2840af0859fd
#My personal
#DASHSCOPE_API_KEY=sk-a355a205b6cd405f8ce6fa0749ce4a2b  
DEFAULT_LLM_MODEL=qwen3-max
#DEFAULT_LLM_MODEL=deepseek-r1

# OpenAI配置（备选）
#OPENAI_API_KEY=sk-69cd11ee67284d569c43330d5a06ff1d
#OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# === MemOS记忆系统配置 ===
MEMOS_API_BASE=https://memos.memtensor.cn/api/openmem/v1
MEMOS_API_KEY=mpg-Jx+1YzdlLyAsim2sVUkrxSntEQUHqC4dKp7DEO78

# ========================================
# ASR 语音识别配置
# ========================================
# 阿里云百炼 Fun-ASR WebSocket API 地址
# 北京地域（默认）
ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# 新加坡地域（如需使用海外服务，取消注释下面这行并注释上面这行）
# ASR_WS_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/inference

# ASR 模型名称（默认：fun-asr-realtime）
# 可选值：
# - fun-asr-realtime: 稳定版（当前等同fun-asr-realtime-2025-11-07）
# - fun-asr-realtime-2025-11-07: 快照版，做了远场VAD优化
# - fun-asr-realtime-2025-09-15: 旧版快照
ASR_MODEL=fun-asr-realtime

# 默认音频采样率（Hz）
# 推荐值：16000（Fun-ASR标准采样率）
ASR_SAMPLE_RATE=16000

# 默认音频格式
# 可选值：pcm, wav, mp3, opus, speex, aac, amr
# 推荐值：pcm（用于实时流式识别）
ASR_FORMAT=pcm

# 默认识别语言
# 可选值：zh（中文）, en（英文）, ja（日语）
ASR_LANGUAGE=zh

# ========================================
# 日历 MCP 服务配置
# ========================================
# 日历 MCP 服务配置
# Host 网络模式下（Linux），容器内 localhost = 宿主机 localhost
CALENDAR_MCP_SERVER_URL=http://localhost:18091/mcp

# 如果日历服务在远程服务器（跨主机部署）
# CALENDAR_MCP_SERVER_URL=http://remote-server:18091/mcp
# CALENDAR_MCP_SERVER_URL=http://10.1.115.38:18091/mcp

# 如果不配置，系统会自动检测网络环境

# 研发机环境：使用远程 IP 地址
# CALENDAR_MCP_SERVER_URL=http://10.1.115.38:18091/mcp


# === MCP服务API密钥 ===
# 滴滴叫车（需要申请）
DIDI_API_KEY=KmalpMJ1key8BmBPr0dbgxdZgbW4vEAP
# production 或 sandbox
DIDI_MCP_MODE=sandbox

# 高德地图（需要申请）
AMAP_TOKEN=d683bf0e0bc3ecf33a2c3469871e8aac

# 博查AI搜索 API Key（用于智能搜索功能）
# 申请地址: https://bocha-ai.feishu.cn/wiki/DCZTwH6OMidCbTkWFRVcVkHonag
# 功能包括: 实时网络搜索、AI智能搜索（需要额外购买次数包）
BOCHA_API_KEY=sk-af3a8f16ba0d4bbdbe8146484370b032

# 飞常准航班信息 API Key（可选 - 用于航班信息查询）
# 申请地址: 飞友AI开放平台 https://ai.variflight.com/
# 功能包括: 航班实时动态、行程价格、舒适度、航班行程价格等
VARIFLIGHT_API_KEY=sk-bTBQXXIxGpVsMtOOxamQwaQm1mI3-u1r-q_6WHdlq-8

# 饿了么外卖 API 配置（可选 - 用于外卖点餐功能）
# 申请地址: 饿了么开放平台（需联系饿了么获取开发者账号）
# 功能包括: 餐厅搜索、菜单查询、购物车管理、订单创建和管理
# 文档: https://openapi-doc.faas.ele.me/v2/api/index.html
# ELEME_APP_KEY=your_eleme_app_key_here
# ELEME_APP_SECRET=your_eleme_app_secret_here
# ELEME_MODE=sandbox  # sandbox（测试环境） 或 production（生产环境）

# 飞书会议 API 配置（可选 - 用于会议管理功能）
# 申请地址: 飞书开放平台 https://open.feishu.cn/
# 功能包括: 创建会议、更新会议、删除会议、获取会议详情、设置主持人、邀请参会人
# 文档: https://feishu.apifox.cn/api-9020884
# 需要权限: 查看、创建和管理日历和会议
FEISHU_APP_ID=cli_a980040f9976100c
FEISHU_APP_SECRET=0dgdzJLHBWO3TPStibFvSghXHd2uvnQQ

# === 数据库配置 ===
# Redis（可选，用于会话存储）
REDIS_URL=redis://localhost:6379/0

# SQLite（默认）
DATABASE_URL=sqlite:///./ty_mem_agent.db

# === 安全配置 ===
SECRET_KEY=your_super_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# === 日志配置 ===
LOG_LEVEL=DEBUG
LOG_FILE=logs/ty_mem_agent.log

# === 记忆配置 ===
MEMORY_MAX_TOKENS=4000
MEMORY_RETENTION_DAYS=30

# === Agent 行为配置 ===
# Agent 主动性级别 (passive/moderate/proactive/aggressive)
# passive: 被动模式 - 只执行明确要求，不主动建议
# moderate: 适中模式 - 适度主动，不会过度打扰
# proactive: 主动模式 - 积极主动服务 (默认)
# aggressive: 激进模式 - 非常主动，提供大量建议
AGENT_PROACTIVITY_LEVEL=proactive

# === Nacos 服务注册配置（可选）===
# 是否启用Nacos服务注册
# 启用后，应用启动时会自动将所有APP API接口注册到Nacos服务注册中心
NACOS_ENABLED=true

# Nacos服务器地址
# 格式: ip:port 或 ip1:port1,ip2:port2（多个地址用逗号分隔）
NACOS_SERVER_ADDRESSES=10.1.115.38:8848

# Nacos命名空间（可选，留空使用public命名空间）
# NACOS_NAMESPACE=your_namespace_id

# Nacos用户名和密码（可选，如果Nacos启用了认证）
# NACOS_USERNAME=nacos
# NACOS_PASSWORD=nacos

# 服务名称（注册到Nacos的服务名）
NACOS_SERVICE_NAME=ty-memory-agent

# 服务组名（可选，不设置时Nacos会使用默认值 DEFAULT_GROUP）
# 只有在需要自定义服务分组时才需要设置此参数
# NACOS_GROUP_NAME=DEFAULT_GROUP

# ========== OpenClaw 通用AI能力集成 ==========
# 推荐架构：ty-mem-agent → OpenClaw 适配层（REST）→ OpenClaw Gateway（Cron/Webhook）
# 联调计划（阶段0～4）: ty_mem_agent/doc/OPENCLAW_INTEGRATION_RUNBOOK.md
# 阶段0完成后运行: python ty_mem_agent/scripts/check_openclaw_phase0.py（在仓库根目录 Qwen-Agent/）
#
# --- 阶段0 · 拓扑（请填实际地址，勿提交真实密钥到公开仓库）---
# TY_MEM_PUBLIC_URL=http://127.0.0.1:8080          # 本服务对外可访问根地址（与 HOST/PORT 一致）
# ADAPTER_PUBLIC_URL=http://127.0.0.1:8090         # 适配层根地址（无 /v1）
# OPENCLAW_GATEWAY_URL=                            # Gateway 地址（阶段2再填）
# --- 密钥对齐见 RUNBOOK 阶段0.2；OPENCLAW_API_KEY=ADAPTER_API_KEY，OPENCLAW_CALLBACK_SECRET=TY_MEM_CALLBACK_HMAC_SECRET ---

# 总开关：false / 0 = 完全关闭 OpenClaw（无预判直通、无本地兜底提交适配层；HTTP 回调 ignored）。未设置时默认 true
OPENCLAW_ENABLED=true

# 适配层 REST 根地址（须含 /openclaw-adapter/v1，与 openclaw_adapter 路由一致；勿填 Gateway 直连）
OPENCLAW_API_BASE=http://127.0.0.1:10083/openclaw-adapter/v1

# 调用适配层的 API Key（由适配层颁发）
OPENCLAW_API_KEY=HJPaEZkyuJ1jQUKA-j5irmgQQoC5RVKwQmdd05HQ1GE

# 验证「适配层 → ty-mem-agent」回调的 HMAC 密钥（与 Gateway cron.webhookToken 分离）
OPENCLAW_CALLBACK_SECRET=KXbFBWpnhIVph4RSD5rex4knZH3VYBvYj6jwHZg23JKVJUz5JkqZlvVkTwECPL5K

# ty-mem-agent 自身公网基础 URL；适配层 POST {BASE}/agent/api/v1/chat/openclaw/callback
OPENCLAW_CALLBACK_BASE_URL=http://127.0.0.1:10081

# 本地 Agent 执行超时阈值（毫秒），超过后触发兜底提交适配层，默认 120000（120 秒）
# OPENCLAW_LOCAL_EXEC_TIMEOUT_MS=120000

# 周期性意图：LLM 解析多语言并生成 cron（关则不走 WS 直通 OpenClaw 周期任务）
OPENCLAW_PERIODIC_INTENT_LLM_ENABLED=true
OPENCLAW_PERIODIC_INTENT_LLM_TIMEOUT_SEC=15
# 周期意图 LLM 使用与聊天相同的 DEFAULT_LLM_MODEL（见上方 LLM 配置），无单独模型项

# === TTS 语音合成配置 ===
# TTS模型（qwen3-tts-flash用于实时场景）
# 官方文档：https://bailian.console.aliyun.com/cn-beijing/?tab=doc#/doc/?type=model&url=2879134
# 支持参数：text（文本）, voice（音色）, language_type（语言类型）
# 输出格式：流式Base64编码的PCM（24kHz, 16bit, mono）
TTS_MODEL=qwen3-tts-flash

# 默认音色（推荐Cherry）
# 可选值：Cherry（女声）, Longxiaochun（女声）, Longwan（男声）, Longfeng（男声）等
# 更多音色请参考：https://help.aliyun.com/zh/model-studio/qwen-tts
TTS_VOICE=Cherry

# 语言类型
# 可选值：Chinese（中文）, English（英文）
TTS_LANGUAGE_TYPE=Chinese

# === 智能分句配置 ===
# 是否使用AI进行智能分句（true=准确但慢, false=快速但可能不够准确）
# 推荐：false（规则模式已经能处理大部分场景，包括小数点、省略号等）
SENTENCE_SPLITTER_USE_AI=false